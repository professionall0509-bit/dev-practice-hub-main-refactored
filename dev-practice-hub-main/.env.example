# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

OPENAI_API_KEY=your-openai-api-key-here

# Optional: only needed if you use sheets_sync.py to export to Google Sheets
SHEET_ID=
SHEET_NAME=Jobs

# Local file paths for Gmail OAuth (these files are gitignored)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Label only, used for logging — auth itself comes from the OAuth files above
GMAIL_ACCOUNT_LABEL=

DATABASE_PATH=job_tracker.db
CHECK_INTERVAL_MINUTES=15
